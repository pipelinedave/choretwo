# Database
POSTGRES_USER=choretwo
POSTGRES_PASSWORD=choretwo_dev
POSTGRES_DB=choretwo

# Redis
REDIS_PASSWORD=redis_dev

# JWT
JWT_SECRET=choretwo-dev-jwt-secret-change-in-production
JWT_EXPIRY=24h

# Dex
DEX_ISSUER_URL=https://dex.stillon.top
DEX_CLIENT_ID=choretwo
DEX_CLIENT_SECRET=choretwo-secret-d236d2961f60b149a49b97b018f08d34

# Mock Auth (set to true for local development)
USE_MOCK_AUTH=true

# Service URLs (for frontend)
VITE_AUTH_SERVICE_URL=http://localhost:8001
VITE_CHORE_SERVICE_URL=http://localhost:8002
VITE_LOG_SERVICE_URL=http://localhost:8003
VITE_NOTIFICATION_SERVICE_URL=http://localhost:8004
VITE_AI_SERVICE_URL=http://localhost:8005

# External Services
GATWAY_URL=http://gotify.stillon.top

# LLM Provider (ai-copilot-service / monolith AI)
# OpenAI-kompatibler Endpoint. Basis-URL bis /v1, der Client haengt
# /chat/completions an. Default-Provider: Synthetic (synthetic.new) mit GLM.
LLM_BASE_URL=https://api.synthetic.new/openai/v1
LLM_MODEL=hf:zai-org/GLM-5.3-Flash
# Alternativ verfuegbare GLM-Modelle: hf:zai-org/GLM-5.2, hf:zai-org/GLM-4.7-Flash
# LLM_API_KEY ist ein SECRET und darf NIEMALS ins Repo. Lokal: .env (gitignored),
# in Produktion: k8s-Secret (SealedSecret in k3s-config). Ohne Key laeuft der
# Copilot im deterministischen Regex-Fallback (kein LLM) weiter.
LLM_API_KEY=

# Legacy adesso AI Hub Sovereign (deprecated, wird noch unterstuetzt, solange
# ALLE LLM_*-Vars unset sind — dann greift der Fallback auf ADESSO_*):
# ADESSO_HUB_URL=https://adesso-ai-hub.3asabc.de/v1/chat/completions
# ADESSO_MODEL=deepseek-v4-flash-sovereign
# ADESSO_API_KEY=
