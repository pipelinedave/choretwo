# Production API configuration
# Both monolith and auth service are behind the same Ingress (nginx ingress),
# which routes /api/... paths per-host. Using RELATIVE base URLs keeps a single
# frontend image working in both staging and production (each host proxies its
# own /api/... to the backend services).
#
# Leave VITE_API_BASE and VITE_AUTH_BASE empty so requests go to the SAME host
# the frontend is served from (choretwo-staging.stillon.top / choretwo.stillon.top).

VITE_API_BASE=
VITE_AUTH_BASE=
