# Frontend API configuration
# VITE_API_BASE — base URL for modular monolith (chores, logs, notify, ai, settings)
# VITE_AUTH_BASE — base URL for standalone Go auth service
#
# In development the Vite dev server (port 3000) proxies:
#   /api/auth    → http://localhost:8001 (Go auth service)
#   /api/chores  → http://localhost:8000 (monolith)
#   /api/logs    → http://localhost:8000 (monolith)
#   /api/notify  → http://localhost:8000 (monolith)
#   /api/ai      → http://localhost:8000 (monolith)
#   /api/settings→ http://localhost:8000 (monolith)
#
# When running against the monolith directly (VITE_API_BASE=http://localhost:8000),
# the API clients bypass the Vite proxy and call the monolith directly.

VITE_API_BASE=http://localhost:3000
VITE_AUTH_BASE=http://localhost:8001
